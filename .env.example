# Google OAuth — server-side only, never exposed to the browser.
# Create credentials at https://console.cloud.google.com (OAuth client, Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — derived from the request when unset
GOOGLE_REDIRECT_URI=
# HMAC/encryption key for session cookies + stored refresh tokens.
# Falls back to GOOGLE_CLIENT_SECRET when unset. Use a dedicated random value.
GOOGLE_TOKEN_SECRET=
# Private beta: comma-separated allowlist of the two permitted accounts.
# Empty list denies everyone unless ALLOW_ANY_EMAIL=1 (local development only).
EDGEBOOK_ALLOWED_EMAILS=
# ALLOW_ANY_EMAIL=1
