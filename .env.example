# Google OAuth — server-side only, never exposed to the browser.
# Create credentials at https://console.cloud.google.com (OAuth client, Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — derived from the request when unset
GOOGLE_REDIRECT_URI=
# HMAC/encryption key for session cookies + stored refresh tokens.
# Falls back to GOOGLE_CLIENT_SECRET when unset. Use a dedicated random value.
GOOGLE_TOKEN_SECRET=

# OpenRouter AI — server-side only, never exposed to the browser.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free-capable model (default shown). Change via env without code changes.
MINATO_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Optional fallback model when the primary is unavailable
MINATO_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free
# Optional vision model (leave empty to disable chart analysis)
MINATO_VISION_MODEL=
